  "name": "开发质检产线",
  "version": "1.0.0",
  "roles": [
    {
      "id": "dev",
      "name": "开发 Agent",
      "responsibility": "根据任务要求实现代码，修复质检反馈并提交验证证据。",
      "input": "任务说明、验收标准、质检反馈",
      "output": "代码变更、测试结果、变更摘要",
      "independent": false,
      "bindings": [
        {
          "skillId": "code",
          "version": 1,
          "when": "实现或返工时",
          "capabilities": "读取项目文件、编辑代码、运行测试（需宿主授权）"
        }
      ]
    },
    {
      "id": "qa",
      "name": "质检 Agent",
      "responsibility": "在独立会话中检查变更，给出有证据的通过或返工结论。",
      "input": "任务说明、代码变更、测试结果",
      "output": "质检报告、通过状态、问题清单",
      "independent": true,
      "bindings": [
        {
          "skillId": "qa",
          "version": 1,
          "when": "开发提交后",
          "capabilities": "读取文件、执行验证（需宿主授权）"
        }
      ]
    }
  ],
  "skills": [
    {
      "id": "code",
      "name": "代码实现规范",
      "versions": [
        {
          "version": 1,
          "definition": "明确需求与验收标准；分步实现变更；运行相关测试并提供变更说明。不可未经确认扩大范围。",
          "resources": []
        }
      ]
    },
    {
      "id": "qa",
      "name": "独立质量检查",
      "versions": [
        {
          "version": 1,
          "definition": "独立检查实现与需求是否一致。复现测试结果，报告证据、严重级别和通过／不通过结论。",
          "resources": []
        }
      ]
    }
  ],

{
  "name": "agent-plugin-designer",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/csp.cjs",
    "test": "vitest run src/model.test.ts",
    "test:e2e": "playwright test",
    "desktop": "go run github.com/egoist/mygo/cmd/mygo dev",
    "dist:win": "go run github.com/egoist/mygo/cmd/mygo build -platform windows/amd64",
    "test:desktop": "node scripts/smoke-desktop.cjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.0",
    "idb": "^8.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.1.0"
  },
  "description": "Local-first visual Agent team plugin designer for Windows",
  "author": "metospace"
}
